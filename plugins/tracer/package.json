{
  "name": "@ember-evaluator/tracer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "files": ["dist", "cordis.patch.yaml"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && node scripts/build.mjs"
  },
  "peerDependencies": {
    "ember-evaluator": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "24.13.5",
    "ember-evaluator": "link:../..",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
